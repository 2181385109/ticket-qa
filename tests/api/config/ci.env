# GitHub Actions:compose 起在 runner 本机,服务用 java -jar 起在同一台 runner,所以地址和本地一样
# 口令由 workflow 通过环境变量注入(ops/.env.example 的默认值),这里只放地址
BASE_URL=http://127.0.0.1:8080
REQUEST_TIMEOUT=20
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ticket_qa
WIREMOCK_URL=http://127.0.0.1:8089
RABBITMQ_MGMT_URL=http://127.0.0.1:15672
# workflow 里 APP_ATTACHMENT_DIR 指到 runner 的 /tmp/attachments,这里同步
ATTACHMENT_DIR=/tmp/ticketqa-attachments
# runner 上服务从 service/ 目录 java -jar 起,文件日志在 service/logs/
SERVICE_LOG_PATH=../../service/logs/ticket-qa-service.log
# runner 自带 docker;compose 项目目录指到 ops/(.env 在那里)
DOCKER_COMPOSE_CMD=docker compose --project-directory ../ops
