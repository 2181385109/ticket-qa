# 本地联调环境:服务跑在宿主 8080,基础设施在 WSL2 Docker 里,端口映射到 127.0.0.1
# 与 ops/.env.example 一致;改了 ops/.env 的端口或密码,这里同步改(或用同名环境变量覆盖)
BASE_URL=http://localhost:8080
REQUEST_TIMEOUT=15
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ticket_qa
MYSQL_USER=ticketqa
MYSQL_PASSWORD=ticketqa123
WIREMOCK_URL=http://localhost:8089
RABBITMQ_MGMT_URL=http://localhost:15672
RABBITMQ_USER=ticketqa
RABBITMQ_PASSWORD=rabbit123
# 附件落盘目录(相对 tests/api 目录);服务本地 `java -jar` 时默认写 service/data/attachments
ATTACHMENT_DIR=../../service/data/attachments
# 服务文件日志(相对 tests/api 目录),fault 用例用它断言 ERROR 行;服务在 service/ 下 java -jar 时写到这里
SERVICE_LOG_PATH=../../service/logs/ticket-qa-service.log
# 故障注入用的 docker compose 命令模板。留空则 fault 用例 skip。
# 下面是 Docker 跑在 WSL2 里的写法:wsl.exe 会把当前目录映射到 /mnt/<盘符>/…,所以 ../ops 相对 tests/(pytest 在 tests/ 下执行)即可;
# 宿主直接有 docker 时写 docker compose --project-directory ../ops(同 ci.env)
DOCKER_COMPOSE_CMD=wsl.exe -d Ubuntu-24.04 -u root -- docker compose --project-directory ../ops
