# 压测工具脚本(tools/*.sh)用到的机器相关路径。
# 复制为 tools/local.env(已在 .gitignore 里)后按本机修改;或者直接 export 同名环境变量,效果一样。
# Git Bash 下路径用 /d/... 写法。
JAVA_HOME=/path/to/jdk-17                    # 留空或不设则用 PATH 里的 java
JMETER_HOME=/path/to/apache-jmeter-5.6.3     # 或直接给 JMETER_JAR=<ApacheJMeter.jar 完整路径>
PY=python                                    # python 不在 PATH 时写完整路径
ARTHAS_BOOT=/path/to/arthas-boot.jar         # 只有 tools/arthas.sh 需要
