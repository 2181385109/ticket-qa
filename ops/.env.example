# ---- 复制为 .env 后使用: cp .env.example .env ----
# .env 已在 .gitignore 中排除,不要提交真实密码 / API key。
# 下面这些默认值与 service/src/main/resources/application.yml 的默认值保持一致,
# 因此 `docker compose up -d` + `mvn spring-boot:run` 可以零改动跑起来。

# MySQL 8
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=ticket_qa
MYSQL_USER=ticketqa
MYSQL_PASSWORD=ticketqa123

# Redis 7
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# RabbitMQ (5672 = AMQP, 15672 = 管理台)
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=ticketqa
RABBITMQ_PASSWORD=rabbit123

# WireMock 挡板(LLM 假实现)
WIREMOCK_PORT=8089

# Prometheus
PROMETHEUS_PORT=9090

# 真实 LLM(仅 llm.mode=real 时需要;走挡板时留空即可)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
